# ==============================================================================
# Pipeline Configuration
# Epidemiological Trajectory, Tree & Sequence Mutation Simulator
# ==============================================================================
# This file is sourced by run_pipeline.sh — it holds every value a user might
# want to tune between runs. Pipeline logic (rate conversions, execution order)
# stays in the shell script itself.
#
# Syntax: plain KEY=VALUE (zsh-sourceable). Arrays use space-separated values
# inside parentheses, matching zsh array syntax.
# ==============================================================================

# ------------------------------------------------------------------------------
# Epidemiological Parameters
# ------------------------------------------------------------------------------
# Re    = Effective reproduction number
# delta = Becoming uninfectious rate (1 / duration of infectiousness)
# s     = Sampling proportion (probability an infected individual is sampled)
RE="1.2"                       # Target effective reproduction number
DELTA_EXPR="365 / 7"           # Removal rate expression (~52.14/year = 7-day infectious period)
S_EXPR="5e-2"                  # Sampling proportion (5% sampled)

MAX_TIME="0.5"                 # Maximum simulation duration (0.5 time units / years)
MIN_SAMPLED="50"               # Minimum number of sampled genomes

# ------------------------------------------------------------------------------
# Trajectory Simulation Settings (simulation.py)
# ------------------------------------------------------------------------------
SIM_OUTPUT_NAME="sim"
SIM_INIT_POP="1"
SIM_TRAJ_TYPE="StochasticTrajectory"
SIM_N_SIMS="1"
SIM_MIN_TIPS="50"

# ------------------------------------------------------------------------------
# Tree Synthesis Settings (BEAST)
# ------------------------------------------------------------------------------
BEAST_WORKDIR="remaster_sims"
BEAST_XML="sim.xml"

# ------------------------------------------------------------------------------
# Sequence & Evolutionary Simulation Parameters (sequence_mutation.py)
# ------------------------------------------------------------------------------
TREE_FILE="./remaster_sims/logs/sim.sampled.trees"
ROOT_SEQUENCE_FILE="focal_sequences_strain.fasta"
ROOT_FILE_TYPE="fasta"
OUTPUT_DIR="sequences"

# Relative exchangeability rates: [AC, AG, AT, CG, CT, GT]
TRANSITION_RATES=(0.5 3 0.5 0.5 6 1)

# Base equilibrium frequencies: [A, C, G, T]
FREQUENCIES=(0.30 0.18 0.20 0.32)

CLOCK_RATE="1e-3"              # Molecular clock rate (substitutions/site/unit time)
GAMMA_SHAPE="0.5"              # Shape parameter (alpha) for gamma site rate variation
GAMMA_CATEGORIES="4"           # Number of discrete rate categories
ROOT_DATE="2002"               # Temporal calendar date assigned to root node
