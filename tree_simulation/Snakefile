import sys
from pathlib import Path
import tomllib

# GENERAL FILE INPUT/OUTPUT PARAMETERS
remaster_output_dir = "data/remaster_trees"
remaster_output_name = "sim"

sequence_mutation_output_dir = "data/simulated_sequences"
sequence_mutation_root_sequence_file = "data/root_sequences/test_root_sequence_500.txt"
sequence_mutation_tree_file = f"{remaster_output_dir}/logs/{remaster_output_name}.sampled.trees"

wastewater_tree_file = f"{remaster_output_dir}/logs/{remaster_output_name}.full.trees"
wastewater_tree_format = "nexus"
wastewater_output_dir = "data/wastewater"

# OTHER GENERAL PARAMETERS
seed = 42
n_sims = 1
simulation_length = 0.4 # years
n_days = int(simulation_length * 365.25)
sequencing_delay = 14 # days
num_segments = 3 # number of segments for episewer analysis


# DERIVED PATHS FROM GENERAL PARAMETERS
sampled_trees_file = f"{remaster_output_dir}/logs/{remaster_output_name}.sampled.trees"
full_trees_file = f"{remaster_output_dir}/logs/{remaster_output_name}.full.trees"


