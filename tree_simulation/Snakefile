wildcard_constraints:
    beast_seed = r"\d+"

rule all:
    input: 
        expand(
            f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined.log",
            tree_id=TREE_IDS,
            config_type=CONFIG_TYPES
        ), # combined log files from beast simulations
        expand(
            f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined-sequences.trees",
            tree_id=TREE_IDS,
            config_type=CONFIG_TYPES
        ), #combined trees files
        expand(
            f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined-sequences.mcc.tree",
            tree_id=TREE_IDS,
            config_type=CONFIG_TYPES
        ), # mcc trees
        expand(
            f"{data_dir}/results/tree_distances/tree_{{tree_id}}/{{prefix}}_{{tree_distance_measure}}.csv",
            tree_id=TREE_IDS,
            prefix=TREE_DISTANCE_PREFIX,
            tree_distance_measure=TREE_DISTANCE_MEASURES
        ), # tree distance calculations
        expand(
            f"{data_dir}/results/tree_distances/plots/{{plot}}.png",
            plot=PLOTS
        ) # tree distance plots


# Create the xml file for the remaster simulation
rule create_remaster_xml:
    input:
        script = "create_remaster_xml.py",
        config = f"{base_configs_dir}/config_remaster_xml.toml"
    output:
        xml = f"{data_dir}/remaster_trees/{remaster_output_name}.xml",
        params = f"{data_dir}/remaster_trees/parameters.txt"
    params:
        output_dir = f"{data_dir}/remaster_trees",
        output_name = remaster_output_name,
        n_sims = n_sims,
        max_time = simulation_length,
        sequencing_delay = sequencing_delay
    shell:
        """
        uv run {input.script} \
            -c {input.config} \
            --output_dir {params.output_dir} \
            --output_name {params.output_name} \
            --n_sims {params.n_sims} \
            --max_time {params.max_time} \
            --sequencing_delay {params.sequencing_delay}
        """

# Run the remaster simulation with beast
rule run_remaster:
    input:
        xml = f"{data_dir}/remaster_trees/{remaster_output_name}.xml"
    output:
        full_trees = f"{data_dir}/remaster_trees/logs/{remaster_output_name}.full.trees",
        sampled_trees = f"{data_dir}/remaster_trees/logs/{remaster_output_name}.sampled.trees",
        traj = f"{data_dir}/remaster_trees/logs/{remaster_output_name}.traj"
    params:
        working_dir = f"{data_dir}/remaster_trees",
        xml = f"{remaster_output_name}.xml",
        seed = 42
    shell:
        """
        cd {params.working_dir}
        beast -overwrite -seed {params.seed} {params.xml}
        cd -
        """

# Simulate sequences along the sampled remaster trees
rule mutate_sequences:
    input:
        script = "sequence_mutation.py",
        config = "configs/config_sequence_mutation.toml",
        tree_file = f"{data_dir}/remaster_trees/logs/{remaster_output_name}.sampled.trees",
        root_sequence_file = sequence_mutation_root_sequence_file
    output:
        seq_info = f"{data_dir}/simulated_sequences/tree_{{tree_id}}/sequences_info.txt",
        seq_rates = f"{data_dir}/simulated_sequences/tree_{{tree_id}}/sequences_rates.txt",
        seq_fasta = f"{data_dir}/simulated_sequences/tree_{{tree_id}}/sequences.fasta",
        tree_with_dates = f"{data_dir}/simulated_sequences/tree_{{tree_id}}/tree_with_dates.nwk"
    params:
        output_dir = f"{data_dir}/simulated_sequences"
    shell:
        """
        uv run {input.script} \
            -c {input.config} \
            --output_dir {params.output_dir} \
            --tree_file {input.tree_file} \
            --tree_id {wildcards.tree_id} \
            --root_sequence_file {input.root_sequence_file}
        """
    
# Simulate wastewater data from the full remaster trees
rule simulate_wastewater_data:
    input:
        script = "wastewater_data.py",
        config = "configs/config_wastewater_data.toml",
        tree_file = f"{data_dir}/remaster_trees/logs/{remaster_output_name}.full.trees"
    output:
        measurements = f"{data_dir}/wastewater/tree_{{tree_id}}/measurements.csv",
        flows = f"{data_dir}/wastewater/tree_{{tree_id}}/flows.csv",
        full_data = f"{data_dir}/wastewater/tree_{{tree_id}}/full_data.csv"
    params:
        output_dir = f"{data_dir}/wastewater",
        tree_format = "nexus",
        sequencing_delay = sequencing_delay,
        n_days = int(simulation_length * 365.25)
    shell:
        """
        uv run {input.script} \
            -c {input.config} \
            --output_dir {params.output_dir} \
            --tree {input.tree_file} \
            --tree_format {params.tree_format} \
            --tree_id {wildcards.tree_id} \
            --sequencing_delay {params.sequencing_delay} \
            --n_days {params.n_days}
        """

rule run_episewer:
    input:
        script = "episewer.R",
        config = "configs/config_episewer.yml",
        wastewater_measurements = f"{data_dir}/wastewater/tree_{{tree_id}}/measurements.csv",
        wastewater_flows = f"{data_dir}/wastewater/tree_{{tree_id}}/flows.csv"
    output:
        summary = f"{data_dir}/wastewater/tree_{{tree_id}}/episewer_summary.csv"
    params:
        data_dir = f"{data_dir}/wastewater",
        sequencing_delay = sequencing_delay
    shell:
        """
        Rscript {input.script} {input.config} \
            --data-dir {params.data_dir} \
            --tree-id {wildcards.tree_id} \
            --sequencing-delay {params.sequencing_delay}
        """

rule make_beast_configs:
    input:
        script = "make_beast_configs.py",
        config = "configs/config_beast_xml_template.toml",
        summaries = f"{data_dir}/wastewater/tree_{{tree_id}}/episewer_summary.csv"
    output:
        configs = expand(f"{data_dir}/configs/tree_{{{{tree_id}}}}/config_beast_xml_{{config_type}}.toml", config_type=CONFIG_TYPES)
        # config_base = "configs/{tree_id}/config_beast_xml_base.toml",
        # config_sections = "configs/{tree_id}/config_beast_xml_sections.toml",
        # config_whole = "configs/{tree_id}/config_beast_xml_whole_period.toml"
        # config_true_values = "configs/{tree_id}/"
    params:
        input_dir_csv = f"{data_dir}/wastewater",
        output_dir = "data/configs",
        simulation_length = simulation_length,
        output_name_base = "config_beast_xml_base.toml",
        output_name_manual = "config_beast_xml_true_values.toml",
        real_Re_str = " ".join(real_Re.astype(str)),
        real_change_times_str = " ".join(real_change_times) if real_change_times else -1,
        sigmas = " ".join(["0.05"] * len(real_Re))
    shell:
        """
        uv run {input.script} \
            --input_dir {params.input_dir_csv} \
            --tree_id {wildcards.tree_id} \
            --output_dir {params.output_dir} \
            --config {input.config} \
            --simulation_length {params.simulation_length} \
            --reverse-sections
        
        cp configs/config_beast_xml_template.toml {params.output_dir}/tree_{wildcards.tree_id}/{params.output_name_base}

        uv run {input.script} \
            --output_dir {params.output_dir}/tree_{wildcards.tree_id} \
            --output_name {params.output_name_manual} \
            --config {input.config} \
            --re-means {params.real_Re_str} \
            --re-sigmas {params.sigmas} \
            --re-change-times {params.real_change_times_str}
        """
            # --reverse-sections is not necessary as we already inversed the Rts and change times earlier. Also, it is also implemented for reading values from csv, not for manual parameters

