rule make_beast_xml:
    input:
        script = "make_beast_xml.py",
        sequences = f"{data_dir}/simulated_sequences/tree_{{tree_id}}/sequences.fasta",
        configs = f"{data_dir}/configs/tree_{{tree_id}}/config_beast_xml_{{config_type}}.toml",
        template = "templates/beast_xmls/template_uniform_sp_prior.xml"
        # config_base = "configs/config_beast_xml_template.toml",
        # config_sections = "configs/{tree_id}/config_beast_xml_sections.toml",
        # config_whole = "configs/{tree_id}/config_beast_xml_whole_period.toml"
        # config_true_values = "configs/{}"
    output:
        output_file = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}.xml"
    group: "beast setup"
    threads: 1
    resources:
        runtime = 10,
        mem_mb_per_cpu = 1000
    shell:
        """
        uv run {input.script} {input.configs} \
            --fasta {input.sequences} \
            -o {output.output_file} \
            --template {input.template}
        """

rule run_beast:
    input:
        xml = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}.xml"
    output:
        trees = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_{{beast_seed}}-sequences.trees",
        logs = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_{{beast_seed}}.log",
        typed_trees = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_{{beast_seed}}.sequences.typed.trees",
        typed_node_trees = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_{{beast_seed}}.sequences.typed.node.trees",
        state = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_{{beast_seed}}.xml.state"
    threads: 4
    resources:
        runtime = wildcards, attempt: 240 + attempt * 60,
        mem_mb_per_cpu = wildcards, attempt: 4000 * attempt
    shell:
        """
        beast \
            -overwrite \
            -seed {wildcards.beast_seed} \
            -working \
            -statefile {output.state} \
            {input.xml}
        """

rule combine_beast_logs:
    input:
        expand(f"{data_dir}/beast_reconstructions/tree_{{{{tree_id}}}}/{{{{config_type}}}}_{{beast_seed}}.log", beast_seed=BEAST_SEEDS)
    output:
        combined_logs = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined.log"
    params:
        burnin = 10,
        inputs = lambda wc, input: " ".join(f"-log {file}" for file in input)
    group: "param_log_post_processing"
    threads: 1
    resources:
        runtime = 30,
        mem_mb_per_cpu = 2000
    shell:
        """
        uv run logcombiner {params.inputs} -b {params.burnin} -o {output.combined_logs}
        """

rule combine_beast_trees:
    input:
        expand(f"{data_dir}/beast_reconstructions/tree_{{{{tree_id}}}}/{{{{config_type}}}}_{{beast_seed}}-sequences.trees", beast_seed=BEAST_SEEDS)
    output:
        combined_trees = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined-sequences.trees"
    params:
        burnin = 10,
        inputs = lambda wc, input: " ".join(f"-log {f}" for f in input)
    threads: 1
    group: "tree_log_post_processing"
    resources:
        runtime = wildcards, attempt: 30 * attempt,
        mem_mb_per_cpu = wildcards, attempt: 5000 * attempt
    shell:
        "uv run logcombiner {params.inputs} -b {params.burnin} -o {output.combined_trees}"

rule annotate_trees:
    input:
        trees = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined-sequences.trees"
    output:
        mcc = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined-sequences.mcc.tree"
    params:
        burnin = 0, # already removed per chain by LogCombiner
        node_heights = "CA", # Common Ancestor heights
        target_type = "MCC" # Maximum clade credibility tree
    threads: 1
    group: "tree_log_post_processing"
    resources:
        runtime = wildcards, attempt: 30 * attempt,
        mem_mb_per_cpu = wildcards, attempt: 5000 * attempt
    shell:
        """
        uv run treeannotator \
            -burnin {params.burnin} \
            -height {params.node_heights} \
            -target {params.target_type} \
            {input.trees} {output.mcc}
        """

rule calculate_tree_distances:
    input:
        ground_truth_tree = f"{data_dir}/simulated_sequences/tree_{{tree_id}}/tree_with_dates.nwk",
        mcc_trees = expand(f"{data_dir}/beast_reconstructions/tree_{{{{tree_id}}}}/{{config_type}}_combined-sequences.mcc.tree", config_type=CONFIG_TYPES)
    output:
        expand(f"{data_dir}/results/tree_distances/tree_{{{{tree_id}}}}/{tree_distance_prefix}_{{tree_distance_measure}}.csv", tree_distance_measure=TREE_DISTANCE_MEASURES)
    params:
        output_dir = f"{data_dir}/results/tree_distances/tree_{{tree_id}}",
        prefix = tree_distance_prefix
    threads: 1
    group: "tree_log_post_processing"
    resources:
        runtime = 10,
        mem_mb_per_cpu = 1000
    shell:
        """
        uv run tree_distances.py {input.ground_truth_tree} {input.mcc_trees} \
            --output_dir {params.output_dir} \
            --csv {params.prefix}
        """

rule plot_tree_distances:
    input:
        expand(f"{data_dir}/results/tree_distances/tree_{{tree_id}}/{tree_distance_prefix}_{{tree_distance_measure}}.csv", tree_id=TREE_IDS, tree_distance_measure=TREE_DISTANCE_MEASURES)
    output:
        expand(f"{data_dir}/results/tree_distances/plots/{{plot}}.png", plot=PLOTS)
    params:
        input_dir = f"{data_dir}/results/tree_distances",
        output_dir = f"{data_dir}/results/tree_distances/plots",
        prefix = tree_distance_prefix 
    threads: 1
    group: "tree_log_post_processing"
    resources:
        runtime = 10,
        mem_mb_per_cpu = 1000
    shell:
        """
        uv run plot_tree_distances.py \
            --input_dir {params.input_dir} \
            --output_dir {params.output_dir} \
            --prefix {params.prefix}
        """

rule analyse_beast_logs:
    input:
        logs = expand(f"{data_dir}/beast_reconstructions/tree_{{{{tree_id}}}}/{{config_type}}_combined.log", config_type=CONFIG_TYPES)
    output:
        dir = directory(f"{data_dir}/results/posterior_analysis/tree_{{tree_id}}")
    params:
        input_dir = f"{data_dir}/beast_reconstructions/tree_{{tree_id}}",
        pattern = r"^.+_combined\.log$",
        burnin = 0
    group: "param_log_post_processing"
    threads: 1
    resources:
        runtime = 10,
        mem_mb_per_cpu = 1000
    shell:
        """
        uv run analyse_beast_logs.py {params.input_dir} \
            --output {output.dir} \
            --pattern "{params.pattern}" \
            --burnin {params.burnin}
        """

rule compare_beast_logs:
    input: 
        logs = expand(f"{data_dir}/beast_reconstructions/tree_{{tree_id}}/{{config_type}}_combined.log", tree_id=TREE_IDS, config_type=CONFIG_TYPES)
    output:
        dir = directory(f"{data_dir}/results/posterior_analysis/comparison")
    params:
        input_dir = f"{data_dir}/beast_reconstructions",
        pattern = r"^.+_combined\.log$",
        estimate = "median",
        reference = "true_values",
        truth = " ".join([
            "samplingProportion=0.025",
            "clockRate=0.00112",
            f"originBDMMPrime={simulation_length}"
        ]),
        burnin = 0
    group: "param_log_post_processing"
    threads: 1
    resources:
        runtime = 10,
        mem_mb_per_cpu = 1000
    shell:
        """
        uv run compare_beast_logs.py {params.input_dir} \
            --output {output.dir} \
            --pattern "{params.pattern}" \
            --estimate {params.estimate} \
            --truth {params.truth} \
            --reference {params.reference} \
            --burnin {params.burnin}
        """