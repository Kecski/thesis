# OTHER GENERAL PARAMETERS
seed = 42
n_sims = 3
simulation_length = 0.5 # years
sequencing_delay = 14 # days

with open("configs/config_remaster_xml.toml", "rb") as f:
    config_remaster = tomllib.load(f)
real_Re = np.array(config_remaster["birth_rate"]) / (np.array(config_remaster["death_rate"]) + np.array(config_remaster["sampling_rate"]))
real_Re = np.flip(real_Re) # The values have to be in reverse order as beast looks at time the opposite way, going back towards the origin

real_change_times = list(map(str, [simulation_length - x for x in config_remaster["change_times_birth"]])) # As beast looks at the time backwards we need to calculate how much time ago did a change happen
real_change_times = real_change_times[::-1] # The same way as with Re, we need to reverse the order


# DERIVED PATHS FROM GENERAL PARAMETERS

# sampled_trees_file = f"{remaster_output_dir}/logs/{remaster_output_name}.sampled.trees"
# full_trees_file = f"{remaster_output_dir}/logs/{remaster_output_name}.full.trees"

BEAST_SEEDS = [17, 42, 37]
TREE_IDS = [i for i in range(n_sims)]
CONFIG_TYPES = ["base", "sections", "whole_period", "true_values"]

TREE_DISTANCE_MEASURES = ["bsd", "clade_age_mad", "clade_age_rmse", "mrca_mad", "mrca_rmse", "n_shared", "rf_norm", "rf", "triplet", "wrf"]
TREE_DISTANCE_PREFIX = "out"

PLOTS = ["clustered_mrca_rmse_mean", "heatmaps_mean", "heatmaps_sd", "mds_mean", "pairwise_distributions"]



