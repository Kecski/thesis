import sys
from pathlib import Path
import tomllib
import numpy as np

# GENERAL FILE INPUT/OUTPUT PARAMETERS
data_dir = "data"
base_configs_dir = "configs"

remaster_output_name = "sim"
sequence_mutation_root_sequence_file = "templates/root_sequences/focal_sequences_strain.fasta"

# remaster_output_dir = f"{data_dir}/remaster_trees"
# sequence_mutation_output_dir = f"{data_dir}/simulated_sequences"
