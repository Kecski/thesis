import sys
from pathlib import Path
import tomllib
import numpy as np

# GENERAL FILE INPUT/OUTPUT PARAMETERS
remaster_output_dir = "data/remaster_trees"
remaster_output_name = "sim"

sequence_mutation_output_dir = "data/simulated_sequences"
sequence_mutation_root_sequence_file = "templates/root_sequences/test_root_sequence_1700.txt"
sequence_mutation_tree_file = f"{remaster_output_dir}/logs/{remaster_output_name}.sampled.trees"

wastewater_tree_file = f"{remaster_output_dir}/logs/{remaster_output_name}.full.trees"
wastewater_tree_format = "nexus"
wastewater_output_dir = "data/wastewater"

beast_dir = "data/beast_reconstructions"

# OTHER GENERAL PARAMETERS
seed = 42
n_sims = 10
simulation_length = 0.5 # years
sequencing_delay = 14 # days
num_segments = 4 # number of segments for episewer analysis

with open("configs/config_remaster_xml.toml", "rb") as f:
    config_remaster = tomllib.load(f)
real_Re = np.array(config_remaster["birth_rate"]) / (np.array(config_remaster["death_rate"]) + np.array(config_remaster["sampling_rate"]))
real_change_times = list(map(str, config_remaster["change_times_birth"]))


# DERIVED PATHS FROM GENERAL PARAMETERS
sampled_trees_file = f"{remaster_output_dir}/logs/{remaster_output_name}.sampled.trees"
full_trees_file = f"{remaster_output_dir}/logs/{remaster_output_name}.full.trees"

TREE_IDS = [i for i in range(n_sims)]
CONFIG_TYPES = ["base", "sections", "whole_period", "true_values"]


