rule all:
    input: 
        f"{sequence_mutation_output_dir}/tree_0/sequences.fasta",
        f"{wastewater_output_dir}/tree_0/measurements.csv",
        f"{wastewater_output_dir}/tree_0/episewer_summary.csv",
        expand(
            "configs/tree_{tree_id}/config_beast_xml_sections.toml", 
            tree_id=TREE_IDS
        ),
        # expand("data/beast_reconstructions/{tree_id}/", tree_id=TREE_IDS)
        expand(
            "data/beast_reconstructions/tree_{tree_id}/{config_type}.xml",
            tree_id=TREE_IDS,
            config_type=CONFIG_TYPES
        ),
        expand(
            f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.log",
            tree_id=TREE_IDS,
            config_type=CONFIG_TYPES
        )


# Create the xml file for the remaster simulation
rule create_remaster_xml:
    input:
        script = "create_remaster_xml.py",
        config = "configs/config_remaster_xml.toml"
    output:
        xml = f"{remaster_output_dir}/{remaster_output_name}.xml",
        params = f"{remaster_output_dir}/parameters.txt"
    params:
        output_dir = remaster_output_dir,
        output_name = remaster_output_name,
        n_sims = n_sims,
        max_time = simulation_length,
        sequencing_delay = sequencing_delay
    shell:
        """
        uv run {input.script} \
            -c {input.config} \
            --output_dir {params.output_dir} \
            --output_name {params.output_name} \
            --n_sims {params.n_sims} \
            --max_time {params.max_time} \
            --sequencing_delay {params.sequencing_delay}
        """

# Run the remaster simulation with beast
rule run_remaster:
    input:
        xml = f"{remaster_output_dir}/{remaster_output_name}.xml"
    output:
        full_trees = full_trees_file,
        sampled_trees = sampled_trees_file,
        traj = f"{remaster_output_dir}/logs/{remaster_output_name}.traj"
    params:
        working_dir = remaster_output_dir,
        xml_name = remaster_output_name
    shell:
        """
        cd {params.working_dir}
        beast -overwrite {params.xml_name}.xml
        cd -
        """

# Simulate sequences along the sampled remaster trees
rule mutate_sequences:
    input:
        script = "sequence_mutation.py",
        config = "configs/config_sequence_mutation.toml",
        tree_file = sampled_trees_file,
        root_sequence_file = sequence_mutation_root_sequence_file
    output:
        seq_info = f"{sequence_mutation_output_dir}/tree_{{tree_id}}/sequences_info.txt",
        seq_rates = f"{sequence_mutation_output_dir}/tree_{{tree_id}}/sequences_rates.txt",
        seq_fasta = f"{sequence_mutation_output_dir}/tree_{{tree_id}}/sequences.fasta"
    params:
        output_dir = sequence_mutation_output_dir
    shell:
        """
        uv run {input.script} \
            -c {input.config} \
            --output_dir {params.output_dir} \
            --tree_file {input.tree_file} \
            --tree_id {wildcards.tree_id} \
            --root_sequence_file {input.root_sequence_file}
        """
    
# Simulate wastewater data from the full remaster trees
rule simulate_wastewater_data:
    input:
        script = "wastewater_data.py",
        config = "configs/config_wastewater_data.toml",
        tree_file = full_trees_file
    output:
        measurements = f"{wastewater_output_dir}/tree_{{tree_id}}/measurements.csv",
        flows = f"{wastewater_output_dir}/tree_{{tree_id}}/flows.csv",
        full_data = f"{wastewater_output_dir}/tree_{{tree_id}}/full_data.csv"
    params:
        output_dir = wastewater_output_dir,
        tree_format = wastewater_tree_format,
        sequencing_delay = sequencing_delay,
        n_days = int(simulation_length * 365.25)
    shell:
        """
        uv run {input.script} \
            -c {input.config} \
            --output_dir {params.output_dir} \
            --tree {input.tree_file} \
            --tree_format {params.tree_format} \
            --tree_id {wildcards.tree_id} \
            --sequencing_delay {params.sequencing_delay} \
            --n_days {params.n_days}
        """

rule run_episewer:
    input:
        script = "episewer.R",
        wastewater_measurements = f"{wastewater_output_dir}/tree_{{tree_id}}/measurements.csv",
        wastewater_flows = f"{wastewater_output_dir}/tree_{{tree_id}}/flows.csv"
    output:
        summary = f"{wastewater_output_dir}/tree_{{tree_id}}/episewer_summary.csv"
    params:
        output_dir = wastewater_output_dir,
        sequencing_delay = sequencing_delay,
        seed = seed,
        num_segments = num_segments
    shell:
        """
        Rscript {input.script} \
            --data-dir {params.output_dir} \
            --tree-id {wildcards.tree_id} \
            --sequencing-delay {params.sequencing_delay} \
            --seed {params.seed} \
            --num-segments {params.num_segments}
        """

rule make_beast_configs:
    input:
        script = "make_beast_configs.py",
        config = "configs/config_beast_xml_template.toml",
        summaries = f"{wastewater_output_dir}/tree_{{tree_id}}/episewer_summary.csv"
    output:
        configs = expand("configs/tree_{{tree_id}}/config_beast_xml_{config_type}.toml", config_type=CONFIG_TYPES)
        # config_base = "configs/{tree_id}/config_beast_xml_base.toml",
        # config_sections = "configs/{tree_id}/config_beast_xml_sections.toml",
        # config_whole = "configs/{tree_id}/config_beast_xml_whole_period.toml"
        # config_true_values = "configs/{tree_id}/"
    params:
        input_dir_csv = wastewater_output_dir,
        output_dir_csv = "configs",
        simulation_length = simulation_length,
        output_name_base = "config_beast_xml_base.toml",
        output_name_manual = "config_beast_xml_true_values.toml",
        real_Re_str = " ".join(real_Re.astype(str)),
        real_change_times_str = " ".join(real_change_times) if real_change_times else -1,
        sigmas = " ".join(["0.05"] * len(real_Re))
    shell:
        """
        uv run {input.script} \
            --input_dir {params.input_dir_csv} \
            --tree_id {wildcards.tree_id} \
            --output_dir {params.output_dir_csv} \
            --config {input.config} \
            --simulation_length {params.simulation_length} \
            --reverse-sections
        
        cp configs/config_beast_xml_template.toml configs/tree_{wildcards.tree_id}/{params.output_name_base}

        uv run {input.script} \
            --output_dir configs/tree_{wildcards.tree_id} \
            --output_name {params.output_name_manual} \
            --config {input.config} \
            --re-means {params.real_Re_str} \
            --re-sigmas {params.sigmas} \
            --re-change-times {params.real_change_times_str} \
            --reverse-sections
        """
