rule make_beast_xml:
    input:
        script = "make_beast_xml.py",
        sequences = f"{sequence_mutation_output_dir}/tree_{{tree_id}}/sequences.fasta",
        configs = "configs/tree_{tree_id}/config_beast_xml_{config_type}.toml",
        template = "templates/beast_xmls/template.xml"
        # config_base = "configs/config_beast_xml_template.toml",
        # config_sections = "configs/{tree_id}/config_beast_xml_sections.toml",
        # config_whole = "configs/{tree_id}/config_beast_xml_whole_period.toml"
        # config_true_values = "configs/{}"
    output:
        output_file = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.xml"
    shell:
        """
        uv run {input.script} {input.configs} \
            --fasta {input.sequences} \
            -o {output.output_file} \
            --template {input.template}
        """

rule run_beast:
    input:
        xml = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.xml"
    output:
        trees = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}-sequences.trees",
        log = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.log",
        typed_trees = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.sequences.typed.trees",
        typed_node_trees = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.sequences.typed.node.trees",
        state = f"{beast_dir}/tree_{{tree_id}}/{{config_type}}.xml.state"
    params:
        beast_dir = beast_dir,
        seed = seed
    shell:
        """
        beast \
            -overwrite \
            -seed {params.seed} \
            -working \
            {params.beast_dir}/tree_{wildcards.tree_id}/{wildcards.config_type}.xml
        """



